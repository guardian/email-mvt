{
	"name": "email-mvt-archive",
	"version": "1.0.0",
	"description": "A Scheduled Lambda function which copies S3 files between two S3 buckets/accounts.",
	"repository": "git@github.com:guardian/email-mvt.git",
	"author": "Guardian News & Media",
	"license": "MIT",
	"private": true,
