	},
	"dependencies": {
		"aws-sdk": "2.1693.0"
	},
	"devDependencies": {
		"@guardian/eslint-config-typescript": "1.0.9",
		"@guardian/prettier": "2.1.1",
		"@types/node": "18.7.16",
		"esbuild": "0.28.0",
		"eslint": "8.22.0",
		"prettier": "2.7.1",
		"ts-node": "10.9.1",
		"typescript": "4.8.2"
	},
	"packageManager": "pnpm@10.33.0"
}